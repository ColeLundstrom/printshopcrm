{
  "name": "printshopcrm",
  "version": "1.35.0",
  "type": "module",
  "description": "Open-source shop management for screen printers, embroiderers and DTF shops — quoting, production, invoicing and per-job profitability, with the CRM built in.",
  "keywords": [
    "screen-printing",
    "embroidery",
    "dtf",
    "print-shop",
    "shop-management",
    "crm",
    "invoicing",
    "sqlite",
    "self-hosted"
  ],
  "homepage": "https://github.com/ColeLundstrom/printshopcrm#readme",
  "bugs": {
    "url": "https://github.com/ColeLundstrom/printshopcrm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColeLundstrom/printshopcrm.git"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env server.mjs",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch server.mjs",
    "seed": "node --no-warnings --env-file-if-exists=.env seed.mjs",
    "reset": "node --no-warnings --env-file-if-exists=.env bin/reset.mjs && npm run seed",
    "admin": "node --no-warnings --env-file-if-exists=.env bin/admin.mjs",
    "restore": "node --no-warnings --env-file-if-exists=.env bin/restore.mjs",
    "snapshot": "node --no-warnings --env-file-if-exists=.env bin/snapshot.mjs",
    "drive": "node --no-warnings --env-file-if-exists=.env bin/backup-drive.mjs",
    "test": "node --test test/*.test.mjs && node bin/gate.mjs",
    "test:e2e": "node bin/gate-e2e.mjs",
    "test:all": "npm test && npm run test:e2e",
    "demo": "node bin/demo.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  }
}
