# PrintShopCRM — environment configuration
#
# Copy to .env and edit. Everything here is optional EXCEPT PSC_SECRET, which you must set for
# any deployment that customers can reach. The app reads plain environment variables; if you use a
# systemd unit, put these in an EnvironmentFile (see deploy/printshopcrm.service).
#
# Per-shop values — tax rate, hourly rate, mail credentials, supplier accounts, Stripe keys — live
# in the app's Settings screen and are stored in the database, not here. Anything set here applies
# to the whole server.


# ─────────────────────────────────────────────────────────────────────────────
# Core — start here
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port the app listens on. Put nginx in front of it in production.
PORT=3333

# REQUIRED IN PRODUCTION. HMAC key for customer share links (estimate approval, art proofs) and
# session integrity. Anyone who knows it can forge a link to any customer document.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PSC_SECRET=

# Multi-tenant mode. Unset (or 0) = a single shop, no login — fine on a private network.
# Set to 1 for signup, staff logins with roles, and an isolated database per shop. Use this for
# anything reachable from the internet.
PSC_AUTH=

# Where the SQLite database lives. Keep it OUTSIDE the application directory so upgrades that
# replace the code cannot touch your data. Per-shop tenant databases are created alongside it.
PSC_DB=/var/lib/printshopcrm/printshop.db

# The shop registry, members, and sessions (multi-tenant mode only).
# Defaults to control.db next to PSC_DB.
PSC_CONTROL_DB=

# Public URL of this install, e.g. https://shop.example.com — used to build the customer-facing
# links in emails. Set it: the fallback trusts the incoming Host header, which a proxy can spoof.
PSC_PUBLIC_URL=

# Email address of the platform operator, if you run this for other shops. Grants access to the
# Control Room screen. Leave blank for a normal install.
PSC_ADMIN_EMAIL=


# ─────────────────────────────────────────────────────────────────────────────
# Branding
# ─────────────────────────────────────────────────────────────────────────────

# Rename and re-skin the app. Handy if you deploy it for clients under your own name.
PSC_BRAND_NAME=
PSC_BRAND_TAG=
PSC_BRAND_ACCENT=

# 'pro' (default, everything) or 'lite' (a stripped, separately-branded estimates+invoices build).
PSC_EDITION=

# Optional "hosted by" credit in the sidebar, for operators running this for other people.
# Both unset = nothing renders, which is what a self-hosted install wants.
# Only http:// and https:// URLs are accepted.
PSC_HOST_BADGE_TEXT=
PSC_HOST_BADGE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# AGPL compliance — read this if you modify the code AND run it for other people
# ─────────────────────────────────────────────────────────────────────────────

# Where users of THIS install can get the source of the version actually running.
#
# The app always shows a source link, because AGPL section 13 requires that anyone interacting with
# it over a network be offered the Corresponding Source. Defaults to the upstream repository, which
# is correct and needs no action IF you run it unmodified, or only for yourself.
#
# If you MODIFY it and run it as a service for other people, you must publish your modified source
# and point this at it. Leaving it aimed upstream while serving patched code is not compliance.
#
# Running it only inside your own shop? Nothing to publish — the AGPL is triggered by serving other
# people, not by using it.
PSC_SOURCE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Outbound email
# ─────────────────────────────────────────────────────────────────────────────
# Shops normally set their OWN mail credentials in Settings so customer mail sends from their own
# domain. These server-wide values are a fallback and are used for platform mail (welcome messages)
# in multi-tenant mode. With nothing configured, messages still record to the Outbox — they are
# never silently dropped.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=          # 'true' for implicit TLS on port 465; leave blank for STARTTLS on 587

# Transactional email providers, as an alternative to SMTP. Set at most one.
PSC_POSTMARK_TOKEN=
PSC_RESEND_KEY=

# Optional GoHighLevel (LeadConnector) relay for PLATFORM mail only — the welcome messages a
# brand-new shop needs before it has configured mail of its own. All three must be set for it to
# activate; GHL_EMAIL_FROM must be on a domain you have verified with the provider.
GHL_PIT=
GHL_LOCATION_ID=
GHL_EMAIL_FROM=


# ─────────────────────────────────────────────────────────────────────────────
# Outbound SMS (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Shops can also set these per-shop in Settings. Unconfigured, texts record to the Outbox.

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=


# ─────────────────────────────────────────────────────────────────────────────
# Payments (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Each shop pastes its OWN Stripe secret key in Settings, so customer money lands in that shop's
# account and this software is never the merchant of record. The variables below are only for an
# operator running a paid multi-tenant service and billing shops a subscription.

PSC_PLATFORM_STRIPE_SECRET=
PSC_STRIPE_WEBHOOK_SECRET=
PSC_FEE_PCT=


# ─────────────────────────────────────────────────────────────────────────────
# AI features (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Email-to-order intake, reply drafting, and the receptionist. Every one of them has a
# deterministic parser that runs with NO model configured — nothing breaks if you skip this.
# Shops normally bring their own Anthropic or OpenAI key in Settings, so usage bills to them.

PSC_AI_MODEL=
CLAUDE_BIN=           # path to a local `claude` CLI, single-shop dev convenience only


# ─────────────────────────────────────────────────────────────────────────────
# Wholesale supplier APIs (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Account credentials go in Settings per shop. These only override the endpoint URLs, which you
# should not normally need to touch.

SSACTIVEWEAR_API_BASE=
SANMAR_INV_URL=
SANMAR_PPC_URL=
ALPHA_INV_URL=
ALPHA_PPC_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Tuning — defaults are sensible, change only if you have a reason
# ─────────────────────────────────────────────────────────────────────────────

PSC_TICK_MS=          # how often the automation/scheduling loop runs, in milliseconds
PSC_TICK_BUDGET=      # max milliseconds one tick may spend before yielding
PSC_MAX_OPEN_DBS=     # LRU cap on simultaneously open tenant databases
PSC_RELAY_DOMAIN=     # inbound-email relay domain, if you run one

# How long to keep webhook delivery history, in days (default 30). Every outbound webhook stores
# its payload, so a busy integration grows this table forever; a daily sweep drops delivered and
# failed rows past the window. Deliveries still being retried are never touched. Set 0 to keep
# everything.
PSC_WEBHOOK_RETENTION_DAYS=
